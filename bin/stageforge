#!/usr/bin/env bash
# stageforge - Agent-agnostic multi-stage autonomous development framework
# Usage: stageforge <command> [project-dir] [options]

set -euo pipefail

VERSION="0.5.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$PROJECT_ROOT/core/compat.sh"

# ─── Colors ───
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ─── Defaults ───
RUNNER=""
MODEL=""
TASK=""
DRY_RUN=false
FAST_TRACK=false
ITERATE=false
CONFIG_FILE=""
# Retry budget precedence (resolved in run_pipeline, after load_config):
#   env STAGEFORGE_MAX_RETRIES > stageforge.yaml max_retries > built-in 3.
# An empty value here means "env did not set it" — the config file may still
# fill it, and the built-in default is applied last.
STAGE_MAX_RETRIES="${STAGEFORGE_MAX_RETRIES:-}"
# Rollback budget precedence (resolved in run_pipeline, after load_config):
#   env STAGEFORGE_MAX_ROLLBACKS > stageforge.yaml max_rollbacks > built-in 3.
# 0 disables rollback (needs_work then degrades to warn + continue).
STAGE_MAX_ROLLBACKS="${STAGEFORGE_MAX_ROLLBACKS:-}"

# ─── Shared modules ───
# shellcheck source=../core/lock.sh
source "$PROJECT_ROOT/core/lock.sh"
# shellcheck source=../core/signal.sh
source "$PROJECT_ROOT/core/signal.sh"
# shellcheck source=../core/validate.sh
source "$PROJECT_ROOT/core/validate.sh"

# ─── Help ───
usage() {
    cat <<EOF
${BOLD}stageforge${NC} v${VERSION} - Multi-stage autonomous development framework

${BOLD}Usage:${NC}
  stageforge init <project-dir>            Initialize a new project
  stageforge run <project-dir> -t <task>   Run full pipeline (Plan->Build->Review->Deliver)
  stageforge iterate <project-dir> -t <task>  Iterate on existing project (Brownfield)
  stageforge quick -t <task>               Quick track for simple tasks
  stageforge status <project-dir>          Check pipeline status
  stageforge resume <project-dir>          Resume from last completed stage

${BOLD}Options:${NC}
  -r, --runner <runner>        Agent runner: claude-code, codex-cli, or path to custom runner
  -m, --model <model>          Override model for all stages
  -t, --task <description>     Task description (required for run/iterate/quick)
  -c, --config <path>          Path to config file (default: ./stageforge.yaml)
      --dry-run                Only run Planner stage, then stop
      --planner-model <model>  Model for Planner stage
      --builder-model <model>  Model for Builder stage
      --reviewer-model <model> Model for Reviewer stage
      --consultant-model <model> Model for Consultant stage
  -v, --version                Show version
  -h, --help                   Show this help

${BOLD}Examples:${NC}
  # Initialize and run a new project
  stageforge init my-app
  stageforge run my-app -t "Build a REST API with Express and TypeScript"

  # Quick track for simple scripts
  stageforge quick -t "Write a Python script to batch rename files"

  # Iterate on existing project with a specific runner
  stageforge iterate my-app -t "Add authentication middleware" -r claude-code

  # Dry run to review the plan first
  stageforge run my-app -t "Add WebSocket support" --dry-run

${BOLD}Runners:${NC}
  claude-code    Claude Code CLI (claude --print)
  codex-cli      OpenAI Codex CLI (codex)
  custom         Any executable accepting run/check/name commands
EOF
    exit 0
}

# ─── Utility Functions ───
info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; exit 1; }
stage() { echo -e "\n${CYAN}${BOLD}━━━ Stage $1: $2 ━━━${NC}"; }

# Extract one scalar value from the config file via grep_oP, trimming
# whitespace, newlines and one layer of surrounding quotes (so `key: ""`
# yields empty rather than the two-character string `""`).
# Usage: _cfgval <anchored-pcre-pattern> <file>
_cfgval() {
    local raw
    raw=$(grep_oP "$1" "$2" || true)
    raw="${raw%%$'\n'*}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    if [[ ${#raw} -ge 2 && (
            ( "${raw:0:1}" == '"'  && "${raw: -1:1}" == '"'  ) ||
            ( "${raw:0:1}" == "'"  && "${raw: -1:1}" == "'"  )
        ) ]]; then
        raw="${raw:1:${#raw}-2}"
    fi
    printf '%s' "$raw"
}

# ─── Load Config ───
load_config() {
    local project_dir="$1"
    local config_path="${CONFIG_FILE:-${project_dir}/stageforge.yaml}"

    if [[ -f "$config_path" ]]; then
        info "Loading config: $config_path"
        # Simple YAML parsing via grep (no yq dependency required).
        # Patterns are anchored (^\s*key:) so comment lines like
        # "# Agent runner: claude-code | ..." cannot match; \K (single
        # backslash!) drops the matched prefix from the output.
        PLANNER_MODEL="${PLANNER_MODEL:-$(_cfgval '^[[:space:]]*planner:[[:space:]]*\K.*' "$config_path")}"
        BUILDER_MODEL="${BUILDER_MODEL:-$(_cfgval '^[[:space:]]*builder:[[:space:]]*\K.*' "$config_path")}"
        REVIEWER_MODEL="${REVIEWER_MODEL:-$(_cfgval '^[[:space:]]*reviewer:[[:space:]]*\K.*' "$config_path")}"
        CONSULTANT_MODEL="${CONSULTANT_MODEL:-$(_cfgval '^[[:space:]]*consultant:[[:space:]]*\K.*' "$config_path")}"
        RUNNER="${RUNNER:-$(_cfgval '^runner:[[:space:]]*\K.*' "$config_path")}"
        # max_retries only applies when the environment left it unset —
        # explicit env config (STAGEFORGE_MAX_RETRIES) wins over the file.
        if [[ -z "$STAGE_MAX_RETRIES" ]]; then
            STAGE_MAX_RETRIES="$(_cfgval '^max_retries:[[:space:]]*\K.*' "$config_path")"
        fi
        if [[ -z "$STAGE_MAX_ROLLBACKS" ]]; then
            STAGE_MAX_ROLLBACKS="$(_cfgval '^max_rollbacks:[[:space:]]*\K.*' "$config_path")"
        fi
    fi

    # Apply global model override
    if [[ -n "$MODEL" ]]; then
        PLANNER_MODEL="$MODEL"
        BUILDER_MODEL="$MODEL"
        REVIEWER_MODEL="$MODEL"
        CONSULTANT_MODEL="$MODEL"
    fi
}

# ─── Detect Runner ───
detect_runner() {
    if [[ -n "$RUNNER" ]]; then
        # Check if it's a built-in runner name
        local runner_path="$PROJECT_ROOT/runners/${RUNNER}.sh"
        if [[ -f "$runner_path" ]]; then
            echo "$runner_path"
            return
        fi
        # Check if it's a path to a custom runner
        if [[ -f "$RUNNER" ]]; then
            echo "$RUNNER"
            return
        fi
        error "Runner not found: $RUNNER"
    fi

    # Auto-detect: try each built-in runner
    for runner_name in claude-code codex-cli; do
        local runner_path="$PROJECT_ROOT/runners/${runner_name}.sh"
        if [[ -f "$runner_path" ]]; then
            source "$runner_path"
            if runner_check 2>/dev/null; then
                echo "$runner_path"
                return
            fi
        fi
    done

    error "No agent runner detected. Install Claude Code CLI or Codex CLI, or specify a runner with -r."
}

# ─── Init Command ───
cmd_init() {
    local project_dir="$1"

    if [[ -z "$project_dir" ]]; then
        error "Project directory required. Usage: stageforge init <project-dir>"
    fi

    mkdir -p "$project_dir"/{docs,stages,src}

    # Copy default config if not exists
    if [[ ! -f "$project_dir/stageforge.yaml" ]]; then
        cp "$PROJECT_ROOT/config/stageforge.yaml" "$project_dir/stageforge.yaml"
    fi

    # Write .gitignore
    cat > "$project_dir/.gitignore" <<'EOF'
stages/.stage_*
stages/.pipeline_*
stages/.run_id
stages/.lock/
stages/stageforge-*
EOF

    ok "Project initialized: $project_dir"
    info "Next: stageforge run $project_dir -t \"your task description\""
}

# ─── Status Command ───
cmd_status() {
    local project_dir="$1"

    if [[ ! -d "$project_dir" ]]; then
        error "Project directory not found: $project_dir"
    fi

    echo -e "${BOLD}Project:${NC} $project_dir"
    echo ""

    local stages=("0:Planner" "1:Builder" "2:Reviewer" "3:Consultant")
    local all_done=true

    for stage_def in "${stages[@]}"; do
        local num="${stage_def%%:*}"
        local name="${stage_def##*:}"
        local signal="$project_dir/stages/.stage_${num}_done"

        if [[ -f "$signal" ]]; then
            local ts
            ts=$(head -n 1 "$signal" 2>/dev/null || true)
            ok "Stage $num ($name): completed at $ts"
        else
            echo -e "${YELLOW}[ ]${NC} Stage $num ($name): pending"
            all_done=false
        fi
    done

    echo ""
    if [[ -f "$project_dir/stages/.pipeline_done" ]]; then
        ok "Pipeline: COMPLETE"
    elif [[ "$all_done" == "true" ]]; then
        warn "Pipeline: all stages done but no .pipeline_done signal"
    else
        info "Pipeline: in progress"
    fi

    # Rollback budget visibility: a malformed needs_work fails open (warn +
    # continue), so the remaining budget must be visible somewhere other than
    # a run's scrollback. Read the same env > config > 3 chain as run_pipeline.
    local rb_max="${STAGEFORGE_MAX_ROLLBACKS:-}"
    if [[ -z "$rb_max" ]]; then
        rb_max=$(_cfgval '^max_rollbacks:[[:space:]]*\K.*' "${CONFIG_FILE:-$project_dir/stageforge.yaml}" 2>/dev/null || true)
    fi
    [[ "$rb_max" =~ ^[0-9]+$ ]] || rb_max=3
    local rb_used=0
    [[ -f "$project_dir/stages/.rollbacks" ]] && rb_used=$(wc -l < "$project_dir/stages/.rollbacks" | tr -d ' ')
    info "Rollbacks used: $rb_used/$rb_max (lifetime per project, counted in stages/.rollbacks; delete that file to reset)"

    local cur_run_id
    cur_run_id=$(signal_current_run_id "$project_dir")
    if [[ -n "$cur_run_id" ]]; then
        info "Current run_id: $cur_run_id"
    fi
}

# ─── Resume Command ───
cmd_resume() {
    local project_dir="$1"
    local task="${TASK:-resume from last completed stage}"

    # Absolutize BEFORE taking the lock: the lock path is stored as given, and
    # a runner that changes the process cwd in-place (mock runner does) would
    # otherwise make release resolve the relative lock path against the wrong
    # directory and leak the lock. run_pipeline re-locks by absolute path and
    # hits the same-PID reentrant path.
    if [[ -d "$project_dir" ]]; then
        project_dir="$(cd "$project_dir" && pwd)"
    fi

    # Keep the state snapshot and the subsequent rewind/run under one lock.
    # run_pipeline's acquire is reentrant for this PID.
    pipeline_lock_acquire "$project_dir" || exit 1

    # Find last *recorded* completed stage (signal existence only).
    local signalled_last
    signalled_last=$(signal_last_complete "$project_dir")

    # Reconcile against artifacts on disk: a stage may be marked done while its
    # outputs are gone. Resume from the last artifact-backed stage instead.
    local last_complete
    last_complete=$(reconcile_resume_point "$project_dir")

    if [[ $last_complete -lt $signalled_last ]]; then
        warn "Recorded progress (Stage $signalled_last) is ahead of intact artifacts (Stage $last_complete). Re-running from Stage $((last_complete + 1))."
    fi

    if [[ $last_complete -eq -1 ]]; then
        info "No artifact-backed completed stages found. Starting from Stage 0."
        cmd_run "$project_dir"
    elif [[ $last_complete -eq 3 ]]; then
        ok "Pipeline already complete."
        cmd_status "$project_dir"
    else
        local next_stage=$((last_complete + 1))
        info "Resuming from Stage $next_stage (last complete: Stage $last_complete)"
        run_pipeline "$project_dir" "$task" "$next_stage"
    fi
}

# ─── Stage Execution Helper ───
# Runs a single stage with prerequisite validation, signal verification, and retries.
# Usage: run_stage_with_verify <stage_num> <stage_name> <prompt_text> <model>
run_stage_with_verify() {
    local stage_num="$1"
    local stage_name="$2"
    local prompt_text="$3"
    local model="${4:-}"

    if ! validate_prerequisites "$stage_num" "$project_dir"; then
        if [[ "$stage_num" == "0" ]]; then
            : # Planner only needs the project dir; warning already printed.
        else
            error "Stage $stage_num ($stage_name) prerequisites not met."
        fi
    fi

    local attempt=1
    while [[ $attempt -le $STAGE_MAX_RETRIES ]]; do
        info "Stage $stage_num ($stage_name) — attempt $attempt/$STAGE_MAX_RETRIES (run_id=$STAGEFORGE_RUN_ID)"

        if runner_run "$stage_name" "$prompt_text" "$project_dir" "$model"; then
            if signal_verify "$stage_num" "$project_dir" "$STAGEFORGE_RUN_ID"; then
                ok "Stage $stage_num ($stage_name) verified."
                return 0
            fi

            # Distinguish between "no file" and "stale file from previous run".
            if signal_check "$stage_num" "$project_dir"; then
                local stale
                stale=$(signal_read_run_id "$stage_num" "$project_dir" || true)
                warn "Stage $stage_num signal found but run_id mismatch (expected=$STAGEFORGE_RUN_ID, got=${stale:-<missing>}). Treating as stale."
                rm -f "$project_dir/stages/.stage_${stage_num}_done"
            else
                warn "Stage $stage_num ran but did not write signal file."
            fi
        else
            warn "Stage $stage_num ($stage_name) runner returned non-zero (attempt $attempt)."
        fi

        attempt=$((attempt + 1))
    done

    signal_fail "$stage_num" "$project_dir" "Failed after $STAGE_MAX_RETRIES attempts"
    error "Stage $stage_num ($stage_name) failed after $STAGE_MAX_RETRIES attempts."
}

# ─── Run Pipeline ───
run_pipeline() {
    local project_dir="$1"
    local task="$2"
    local start_stage="${3:-0}"

    # Normalize to an absolute path so runners that `cd` internally cannot
    # corrupt subsequent retries (or downstream relative path resolution).
    if [[ ! -d "$project_dir" ]]; then
        error "Project directory not found: $project_dir"
    fi
    project_dir="$(cd "$project_dir" && pwd)"

    # One run per project directory: guards the whole stages/ critical
    # section (.run_id rewrite, signal clean/create, verification reads).
    pipeline_lock_acquire "$project_dir" || exit 1

    load_config "$project_dir"

    # Resolve the retry budget now that config has been read (env > file > 3),
    # rejecting junk values instead of letting them blow up in the loop's
    # arithmetic test. max_retries: 0 is honored literally (no attempt runs).
    if [[ -z "$STAGE_MAX_RETRIES" ]]; then
        STAGE_MAX_RETRIES=3
    elif [[ ! "$STAGE_MAX_RETRIES" =~ ^[0-9]+$ ]]; then
        warn "Ignoring invalid max_retries: '$STAGE_MAX_RETRIES' (using 3)"
        STAGE_MAX_RETRIES=3
    fi

    # Rollback budget: durable, per project (stages/.rollbacks line count).
    # Same resolution rules as max_retries; 0 disables rollback entirely.
    if [[ -z "$STAGE_MAX_ROLLBACKS" ]]; then
        STAGE_MAX_ROLLBACKS=3
    elif [[ ! "$STAGE_MAX_ROLLBACKS" =~ ^[0-9]+$ ]]; then
        warn "Ignoring invalid max_rollbacks: '$STAGE_MAX_ROLLBACKS' (using 3)"
        STAGE_MAX_ROLLBACKS=3
    fi

    local runner_path
    runner_path=$(detect_runner)
    source "$runner_path"

    # Wipe any stale signal files from start_stage onwards so old runs cannot
    # falsely satisfy validate_prerequisites for the new run.
    signal_clean_from "$project_dir" "$start_stage"

    # Allocate a fresh run-ID for this invocation and export it so that runners
    # / AI subprocesses can embed it into the signal files they write.
    # Use the freshly generated value directly — do NOT read it back from
    # stages/.run_id: a concurrent run in the same directory could overwrite
    # that file between write and read, making this run stamp signals with
    # another run's ID.
    local run_id
    run_id=$(signal_init_run "$project_dir")
    export STAGEFORGE_RUN_ID="$run_id"
    # Match policy.py resolution: yaml/yml first, then json.
    if [ -f "${HOME:-}/.stageforge/policy.yaml" ]; then
        export POLICY_FILE="${HOME:-}/.stageforge/policy.yaml"
    elif [ -f "${HOME:-}/.stageforge/policy.yml" ]; then
        export POLICY_FILE="${HOME:-}/.stageforge/policy.yml"
    elif [ -f "${HOME:-}/.stageforge/policy.json" ]; then
        export POLICY_FILE="${HOME:-}/.stageforge/policy.json"
    fi

    info "Runner: $(runner_name)"
    info "Project: $project_dir"
    info "Task: $task"
    info "Start stage: $start_stage"
    info "Run ID: $run_id"

    local run_id_block="## Run ID\nWrite this exact id into stages/.stage_<N>_done as the second line in the form 'run_id: <id>'. The same value is exported as the STAGEFORGE_RUN_ID environment variable.\n$run_id"

    # Stages run in a loop, not as sequential blocks, so a completed stage can
    # request a bounded rewind (verdict contract, see core/signal.sh's
    # signal_read_verdict): rollback re-runs from the requested stage with
    # signals cleaned from there on. Artifacts of stages >= N are left on disk
    # and are overwritten by the re-run — KNOWN BEHAVIOR, documented in the
    # README (this includes manual edits when N is before this run's start).
    local s="$start_stage"
    while (( s <= 3 )); do
        local stage_name prompt_text model
        stage_name=""
        prompt_text=""
        model=""
        case "$s" in
            0)
                stage_name="planner"
                prompt_text="$(cat "$PROJECT_ROOT/prompts/planner.md")\n\n$run_id_block\n\n## Task\n$task\n\n## Project Directory\n$project_dir"
                model="${PLANNER_MODEL:-}"
                ;;
            1)
                stage_name="builder"
                prompt_text="$(cat "$PROJECT_ROOT/prompts/builder.md")\n\n$run_id_block\n\n## Plan Location\n$project_dir/docs/PLAN.md\n\n## Project Directory\n$project_dir"
                model="${BUILDER_MODEL:-}"
                ;;
            2)
                stage_name="reviewer"
                prompt_text="$(cat "$PROJECT_ROOT/prompts/reviewer.md")\n\n$run_id_block\n\n## Project Directory\n$project_dir"
                model="${REVIEWER_MODEL:-}"
                ;;
            3)
                stage_name="consultant"
                prompt_text="$(cat "$PROJECT_ROOT/prompts/consultant.md")\n\n$run_id_block\n\n## Project Directory\n$project_dir"
                model="${CONSULTANT_MODEL:-}"
                ;;
            *)
                # Unreachable: $s is always a plain integer in [0,3] here
                # (start_stage is validated, return_to is normalized). Kept
                # so a future non-integer can never silently reuse the
                # previous iteration's stage_name/prompt/model.
                error "Internal error: unknown stage number '$s'."
                ;;
        esac

        stage "$s" "$stage_name"
        run_stage_with_verify "$s" "$stage_name" "$prompt_text" "$model"

        if [[ "$DRY_RUN" == true ]] && [[ "$s" -eq 0 ]]; then
            ok "Dry run complete. Review: $project_dir/docs/PLAN.md"
            ok "Remove --dry-run to continue the pipeline."
            exit 0
        fi

        # Verdict contract: judged AFTER verify passes, by re-reading the
        # signal file (single writer, inside the lock). Never signalled via
        # return codes — set -e's if-context would swallow them.
        local verdict_read verdict return_to
        verdict_read=$(signal_read_verdict "$s" "$project_dir")
        verdict="${verdict_read%%|*}"
        return_to="${verdict_read#*|}"

        if [[ "$verdict" == "needs_work" ]]; then
            if ! [[ "$return_to" =~ ^[0-9]+$ ]] || (( 10#$return_to >= s )); then
                if [[ "$s" -eq 0 ]]; then
                    warn "Stage 0 wrote verdict 'needs_work' with return_to '${return_to:-<missing>}', but there is no earlier stage to return to — treating as ok and continuing."
                else
                    warn "Stage $s wrote verdict 'needs_work' with invalid return_to '${return_to:-<missing>}' (expected integer in [0, $((s - 1))]) — treating as ok and continuing."
                fi
            elif [[ "$STAGE_MAX_ROLLBACKS" -eq 0 ]]; then
                warn "Stage $s requested rollback to $return_to but max_rollbacks is 0 — continuing."
            else
                # Normalize before use: "01" passes the digit check but would
                # reach `case "$s"` as the string "01", matching no arm.
                local target=$((10#$return_to))
                local rb_used=0
                [[ -f "$project_dir/stages/.rollbacks" ]] && rb_used=$(wc -l < "$project_dir/stages/.rollbacks" | tr -d ' ')
                if (( rb_used >= STAGE_MAX_ROLLBACKS )); then
                    warn "Stage $s requested rollback to $target but the rollback budget is exhausted ($rb_used/$STAGE_MAX_ROLLBACKS) — continuing."
                else
                    if (( target < start_stage )); then
                        warn "Rollback to Stage $target crosses this run's start (Stage $start_stage): earlier artifacts, including any manual edits, will be overwritten by the re-run."
                    fi
                    warn "Stage $s requested rollback — rewinding to Stage $target."
                    # Clean FIRST, then record: a crash in between can only
                    # under-count the budget by one, never consume budget for
                    # a rollback that never happened.
                    signal_clean_from "$project_dir" "$target"
                    echo "$(date_iso) stage_$s -> stage_$target (needs_work)" >> "$project_dir/stages/.rollbacks"
                    s="$target"
                    continue
                fi
            fi
        elif [[ -n "$verdict" ]] && [[ "$verdict" != "ok" ]]; then
            # signal_read_verdict's contract: anything that is neither
            # needs_work nor ok is malformed → warn with the raw value and
            # continue. Models drift ("NEEDS_WORK", "rework", "needs-work"),
            # and silence would hide the drift.
            warn "Stage $s wrote unrecognized verdict '$verdict' — treating as ok and continuing."
        fi

        s=$((s + 1))
    done

    # Pipeline complete — record the run that produced it.
    {
        echo "$(date_iso)"
        echo "run_id: $run_id"
    } > "$project_dir/stages/.pipeline_done"
    echo ""
    ok "Pipeline complete! 🎉"
    cmd_status "$project_dir"
}

# ─── Run Command ───
cmd_run() {
    local project_dir="$1"

    if [[ -z "$project_dir" ]]; then
        error "Project directory required. Usage: stageforge run <project-dir> -t <task>"
    fi
    if [[ -z "$TASK" ]]; then
        error "Task description required. Use -t or --task."
    fi

    run_pipeline "$project_dir" "$TASK" 0
}

# ─── Iterate Command ───
cmd_iterate() {
    local project_dir="$1"

    if [[ -z "$project_dir" ]]; then
        error "Project directory required. Usage: stageforge iterate <project-dir> -t <task>"
    fi
    if [[ -z "$TASK" ]]; then
        error "Task description required. Use -t or --task."
    fi
    if [[ ! -d "$project_dir/src" ]] && [[ ! -d "$project_dir/contracts" ]] && [[ ! -d "$project_dir/lib" ]]; then
        error "No source code found. Use 'run' for new projects."
    fi

    # Brownfield: set environment variable for prompts
    export STAGEFORGE_MODE="brownfield"

    run_pipeline "$project_dir" "$TASK" 0
}

# ─── Quick Command ───
cmd_quick() {
    if [[ -z "$TASK" ]]; then
        error "Task description required. Use -t or --task."
    fi

    # Create temp project dir
    local project_dir
    project_dir=$(mktemp -d -t stageforge-quick-XXXXXX)
    mkdir -p "$project_dir"/{docs,stages,src}

    load_config "$project_dir"
    local runner_path
    runner_path=$(detect_runner)
    source "$runner_path"

    info "Runner: $(runner_name)"
    info "Quick track: $TASK"

    stage "⚡" "Quick Build"
    local builder_prompt
    builder_prompt=$(cat "$PROJECT_ROOT/prompts/builder.md")

    if runner_run "builder" "$builder_prompt\n\n## Task (Quick Track)\n$TASK\n\n## Project Directory\n$project_dir\n\n## Instructions\nBuild and verify the solution. This is a quick-track task - keep it simple and focused." "$project_dir" "${BUILDER_MODEL:-}"; then
        ok "Quick track complete! 🎉"
        info "Output: $project_dir"
    else
        error "Quick track failed."
    fi
}

# ─── Parse Arguments ───
COMMAND=""
PROJECT_DIR=""
PLANNER_MODEL=""
BUILDER_MODEL=""
REVIEWER_MODEL=""
CONSULTANT_MODEL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        init|run|iterate|quick|status|resume)
            COMMAND="$1"
            shift
            if [[ "$COMMAND" != "quick" ]] && [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; then
                PROJECT_DIR="$1"
                shift
            fi
            ;;
        -r|--runner)     RUNNER="$2"; shift 2 ;;
        -m|--model)      MODEL="$2"; shift 2 ;;
        -t|--task)       TASK="$2"; shift 2 ;;
        -c|--config)     CONFIG_FILE="$2"; shift 2 ;;
        --dry-run)       DRY_RUN=true; shift ;;
        --planner-model)     PLANNER_MODEL="$2"; shift 2 ;;
        --builder-model)     BUILDER_MODEL="$2"; shift 2 ;;
        --reviewer-model)    REVIEWER_MODEL="$2"; shift 2 ;;
        --consultant-model)  CONSULTANT_MODEL="$2"; shift 2 ;;
        -v|--version)    echo "stageforge v${VERSION}"; exit 0 ;;
        -h|--help)       usage ;;
        *)               error "Unknown option: $1" ;;
    esac
done

# ─── Execute ───
case "$COMMAND" in
    init)     cmd_init "$PROJECT_DIR" ;;
    run)      cmd_run "$PROJECT_DIR" ;;
    iterate)  cmd_iterate "$PROJECT_DIR" ;;
    quick)    cmd_quick ;;
    status)   cmd_status "$PROJECT_DIR" ;;
    resume)   cmd_resume "$PROJECT_DIR" ;;
    *)        usage ;;
esac
